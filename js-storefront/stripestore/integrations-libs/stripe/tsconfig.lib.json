{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "../../out-tsc/lib",
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "node",
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "inlineSources": true,
    "experimentalDecorators": true,
    "importHelpers": true,
    "resolveJsonModule": true,
    "esModuleInterop": true,
    "types": [],
    "lib": ["dom", "ES2022"],
    "paths": {
      "sap-commerce-stripe-payment/root": ["./integrations-libs/stripe/root/public_api.ts"],
      "sap-commerce-stripe-payment/core": ["./integrations-libs/stripe/core/public_api.ts"],
      "sap-commerce-stripe-payment/components": ["./integrations-libs/stripe/components/public_api.ts"],
      "sap-commerce-stripe-payment/assets": ["./integrations-libs/stripe/assets/public_api.ts"]
    }
  },
  "angularCompilerOptions": {
    "compilationMode": "partial",
    "strictMetadataEmit": true,
    "enableResourceInlining": false
  },
  "include": ["./**/*.ts"],
  "exclude": ["**/*.spec.ts", "test.ts", "schematics/**/*.ts"]
}
