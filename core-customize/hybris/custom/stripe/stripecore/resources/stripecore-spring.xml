<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans http://www.springframework.org/schema/beans/spring-beans.xsd">

    <alias name="defaultStripeConfigurationService" alias="stripeConfigurationService"/>
    <bean id="defaultStripeConfigurationService" class="com.stripe.core.config.impl.DefaultStripeConfigurationService">
        <property name="configurationService" ref="configurationService"/>
        <property name="baseSiteService" ref="baseSiteService"/>
    </bean>

    <alias name="defaultStripeGateway" alias="stripeGateway"/>
    <bean id="defaultStripeGateway" class="com.stripe.core.gateway.impl.DefaultStripeGateway">
        <property name="stripeConfigurationService" ref="stripeConfigurationService"/>
    </bean>

    <alias name="defaultStripeAmountConverter" alias="stripeAmountConverter"/>
    <bean id="defaultStripeAmountConverter" class="com.stripe.core.amount.impl.DefaultStripeAmountConverter">
        <property name="commonI18NService" ref="commonI18NService"/>
    </bean>

    <bean id="stripeClient" class="com.stripe.core.stripe.StripeClient">
        <property name="stripeConfigurationService" ref="stripeConfigurationService"/>
        <property name="stripeAmountConverter" ref="stripeAmountConverter"/>
    </bean>

    <bean id="stripePaymentProvider" class="com.stripe.core.stripe.StripePaymentProvider">
        <property name="stripeClient" ref="stripeClient"/>
        <property name="stripeConfigurationService" ref="stripeConfigurationService"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <alias name="defaultStripePaymentIntentRecordDao" alias="stripePaymentIntentRecordDao"/>
    <bean id="defaultStripePaymentIntentRecordDao" class="com.stripe.core.dao.impl.DefaultStripePaymentIntentRecordDao">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>

    <alias name="defaultStripePaymentIntentService" alias="stripePaymentIntentService"/>
    <bean id="defaultStripePaymentIntentService" class="com.stripe.core.payment.impl.DefaultStripePaymentIntentService">
        <property name="stripeGateway" ref="stripeGateway"/>
        <property name="stripeConfigurationService" ref="stripeConfigurationService"/>
        <property name="stripeAmountConverter" ref="stripeAmountConverter"/>
        <property name="stripePaymentIntentRecordDao" ref="stripePaymentIntentRecordDao"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <alias name="defaultStripeTransactionLookup" alias="stripeTransactionLookup"/>
    <bean id="defaultStripeTransactionLookup" class="com.stripe.core.payment.impl.DefaultStripeTransactionLookup">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>

    <alias name="defaultStripeWebhookEventDao" alias="stripeWebhookEventDao"/>
    <bean id="defaultStripeWebhookEventDao" class="com.stripe.core.dao.impl.DefaultStripeWebhookEventDao">
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
    </bean>

    <alias name="stripeCommercePaymentAuthorizationStrategy" alias="commercePaymentAuthorizationStrategy"/>
    <bean id="stripeCommercePaymentAuthorizationStrategy"
          class="com.stripe.core.order.StripeCommercePaymentAuthorizationStrategy"
          parent="defaultPaymentAuthorizationStrategy">
        <property name="stripeAmountConverter" ref="stripeAmountConverter"/>
    </bean>

    <alias name="defaultStripePaymentIntentRecordService" alias="stripePaymentIntentRecordService"/>
    <bean id="defaultStripePaymentIntentRecordService"
          class="com.stripe.core.payment.impl.DefaultStripePaymentIntentRecordService">
        <property name="stripePaymentIntentRecordDao" ref="stripePaymentIntentRecordDao"/>
        <property name="stripeTransactionLookup" ref="stripeTransactionLookup"/>
        <property name="stripeGateway" ref="stripeGateway"/>
        <property name="stripeAmountConverter" ref="stripeAmountConverter"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <alias name="defaultStripeOrderPlacementLockService" alias="stripeOrderPlacementLockService"/>
    <bean id="defaultStripeOrderPlacementLockService"
          class="com.stripe.core.order.impl.DefaultStripeOrderPlacementLockService">
        <property name="modelService" ref="modelService"/>
        <property name="flexibleSearchService" ref="flexibleSearchService"/>
        <property name="stripePaymentIntentRecordDao" ref="stripePaymentIntentRecordDao"/>
    </bean>

    <alias name="defaultStripeOrderAuthorizationService" alias="stripeOrderAuthorizationService"/>
    <bean id="defaultStripeOrderAuthorizationService"
          class="com.stripe.core.order.impl.DefaultStripeOrderAuthorizationService">
        <property name="paymentService" ref="paymentService"/>
        <property name="stripeAmountConverter" ref="stripeAmountConverter"/>
        <property name="i18nService" ref="i18nService"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <!-- stripeOrderPlacementService (Task 11) and stripeOrderCancellationService (Task 12) are added as properties
         of this bean by the tasks that define those beans. -->
    <alias name="defaultStripePaymentIntentEventHandler" alias="stripePaymentIntentEventHandler"/>
    <bean id="defaultStripePaymentIntentEventHandler"
          class="com.stripe.core.webhook.impl.DefaultStripePaymentIntentEventHandler">
        <property name="stripePaymentIntentRecordDao" ref="stripePaymentIntentRecordDao"/>
        <property name="stripePaymentIntentRecordService" ref="stripePaymentIntentRecordService"/>
        <property name="stripeGateway" ref="stripeGateway"/>
        <property name="stripePaymentIntentService" ref="stripePaymentIntentService"/>
        <property name="stripeConfigurationService" ref="stripeConfigurationService"/>
        <property name="stripeOrderAuthorizationService" ref="stripeOrderAuthorizationService"/>
        <property name="modelService" ref="modelService"/>
        <property name="timeService" ref="timeService"/>
    </bean>

    <alias name="defaultStripeRefundEventHandler" alias="stripeRefundEventHandler"/>
    <bean id="defaultStripeRefundEventHandler" class="com.stripe.core.webhook.impl.DefaultStripeRefundEventHandler">
        <property name="stripeTransactionLookup" ref="stripeTransactionLookup"/>
        <property name="modelService" ref="modelService"/>
    </bean>

    <bean id="stripeWebhookEventTaskRunner" class="com.stripe.core.webhook.StripeWebhookEventTaskRunner">
        <property name="modelService" ref="modelService"/>
        <property name="stripePaymentIntentEventHandler" ref="stripePaymentIntentEventHandler"/>
        <property name="stripeRefundEventHandler" ref="stripeRefundEventHandler"/>
    </bean>

    <import resource="stripecore-commands-spring.xml"/>
</beans>
