#
# Import the Solr CronJob Trigger configuration for the Stripe Product Catalog
#

INSERT_UPDATE Trigger;cronJob(code)[unique=true];second;minute;hour;day;month;year;relative;active;maxAcceptableDelay

# Run the full-stripeIndex-cronJob at 3:05 AM every day
;full-stripeIndex-cronJob;0;5;3;-1;-1;-1;false;false;-1

# Run the update-stripeIndex-cronJob every 1 minutes
;update-stripeIndex-cronJob;0;1;-1;-1;-1;-1;true;false;-1
