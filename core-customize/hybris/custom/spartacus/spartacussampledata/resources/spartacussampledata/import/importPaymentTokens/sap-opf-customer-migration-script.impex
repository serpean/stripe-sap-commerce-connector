# -----------------------------------------------------------------------
# Customer Migration to OPF - Scripting CronJob

# -----------------------------------------------------------------------

# GROOVY SCRIPT
INSERT_UPDATE Script; code[unique=true];content
                    ;opfCustomerMigrationScript;"
import de.hybris.platform.opfservices.data.OpfCustomerImportRequest
import de.hybris.platform.servicelayer.search.FlexibleSearchQuery
import de.hybris.platform.servicelayer.search.SearchResult
import de.hybris.platform.util.Config
import org.slf4j.LoggerFactory

def LOG = LoggerFactory.getLogger('opfCustomerMigrationScript')

// ============================================================
// IMPORTANT: This script assumes a custom item type exists that
// stores the customer-to-PSP-customer mapping.
//
// Customers MUST replace the following placeholders:
//   - ITEM_TYPE_NAME: Replace with your mapping table's type code
//     (e.g., 'PspCustomerMapping', 'CustomerExternalId')
//   - CUSTOMER_ID_ATTR: The attribute storing CCV2 customer ID
//   - PSP_CUSTOMER_ID_ATTR: The attribute storing PSP customer ID
//
// Example query (replace with your actual item type):
//   SELECT {pk} FROM {PspCustomerMapping}
//   WHERE {pk} > ?lastPk ORDER BY {pk}
// ============================================================

// ---- Configuration ----
def BATCH_SIZE = Config.getInt('opf.migration.batch.size', 1000)
def MAX_RETRIES = Config.getInt('opf.migration.max.retries', 3)
def ACCOUNT_GROUP_ID = Config.getString('opf.migration.accountGroupId', '0')
def SCAN_PAGE_SIZE = Config.getInt('opf.migration.scan.page.size', 5000)
def COOLDOWN_MS = Config.getInt('opf.migration.cooldown.ms', 2000)
def PROP_STATUS = 'migrationStatus'
def PROP_RETRY = 'retryCount'
def STATUS_MIGRATED = 'MIGRATED'
def STATUS_FAILED = 'FAILED'

// ---- Placeholder: Replace with your actual item type code ----
def ITEM_TYPE_NAME = 'PspCustomerMapping'
def CUSTOMER_ID_ATTR = 'customerId'
def PSP_CUSTOMER_ID_ATTR = 'pspCustomerId'

// ---- Get Spring beans ----
def flexibleSearchService = spring.getBean('flexibleSearchService')
def modelService = spring.getBean('modelService')
def ccAdapterClient = spring.getBean('ccAdapterClient')

// ---- Helper: Get/Set dynamic properties via Jalo layer ----
def getDynamicProperty = { model, key ->
    return modelService.getSource(model).getProperty(key)
}
def setDynamicProperty = { model, key, value ->
    modelService.getSource(model).setProperty(key, value)
}

// ---- PK-marker based fetch: avoids re-scanning already processed records ----
def lastProcessedPk = 0L

def fetchUnmigratedBatch = { int batchSize ->
    def collected = []
    def currentPk = lastProcessedPk

    while (collected.size() < batchSize) {
        def query = 'SELECT {pk} FROM {' + ITEM_TYPE_NAME + '} WHERE {pk} > ?lastPk ORDER BY {pk}'
        def fsQuery = new FlexibleSearchQuery(query)
        fsQuery.addQueryParameter('lastPk', currentPk)
        fsQuery.setCount(SCAN_PAGE_SIZE)
        SearchResult result = flexibleSearchService.search(fsQuery)

        if (result.getResult().isEmpty()) {
            break
        }

        for (def record : result.getResult()) {
            currentPk = record.getPk().getLong()

            def status = getDynamicProperty(record, PROP_STATUS)
            if (status == null || STATUS_FAILED.equals(status)) {
                collected.add(record)
                if (collected.size() >= batchSize) break
            }
        }

        if (result.getResult().size() < SCAN_PAGE_SIZE) {
            break
        }
    }

    lastProcessedPk = currentPk
    return collected
}

// ---- Convert mapping record to OpfCustomerImportRequest ----
def convertToImportRequest = { record ->
    def customerId = modelService.getAttributeValue(record, CUSTOMER_ID_ATTR)
    def pspCustomerId = modelService.getAttributeValue(record, PSP_CUSTOMER_ID_ATTR)

    if (customerId == null) {
        return null
    }

    def request = new OpfCustomerImportRequest()
    request.setCustomerId(customerId)
    request.setAccountGroupId(ACCOUNT_GROUP_ID)
    request.setPspCustomerId(pspCustomerId)
    return request
}

// ---- Processing Migration ----
LOG.info('=== Customer Migration Started ===')
LOG.info('Batch size: {}, Max retries: {}, Account group ID: {}, Scan page size: {}, Cooldown: {}ms', BATCH_SIZE, MAX_RETRIES, ACCOUNT_GROUP_ID, SCAN_PAGE_SIZE, COOLDOWN_MS)

def startTime = System.currentTimeMillis()

def counters = [migrated: 0, failed: 0, batches: 0]
def hasRecords = true

while (hasRecords) {
    def batch = fetchUnmigratedBatch(BATCH_SIZE)

    if (batch.isEmpty()) {
        hasRecords = false
        break
    }

    counters.batches++
    LOG.info('Batch #{}: processing {} records', counters.batches, batch.size())

    // Convert batch to OpfCustomerImportRequest objects
    def requests = []
    def recordList = []
    batch.each { record ->
        def request = convertToImportRequest(record)
        if (request != null) {
            requests.add(request)
            recordList.add(record)
        } else {
            setDynamicProperty(record, PROP_STATUS, STATUS_FAILED)
            setDynamicProperty(record, PROP_RETRY, MAX_RETRIES)
            counters.failed++
        }
    }

    if (requests.isEmpty()) {
        LOG.info('No valid records in batch, skipping API call')
        continue
    }

    // Call OPF batch import API with retry
    def batchSuccess = false
    def lastError = null

    for (int attempt = 1; attempt <= MAX_RETRIES; attempt++) {
        try {
            def apiStart = System.currentTimeMillis()
            ccAdapterClient.importSavedCustomers(requests)
            def apiElapsed = System.currentTimeMillis() - apiStart

            // Success - mark all records as MIGRATED
            recordList.each { record ->
                setDynamicProperty(record, PROP_STATUS, STATUS_MIGRATED)
                setDynamicProperty(record, PROP_RETRY, 0)
            }
            counters.migrated += requests.size()
            LOG.info('Batch #{}: API call succeeded in {}ms, {} records migrated', counters.batches, apiElapsed, requests.size())
            batchSuccess = true
            break

        } catch (Exception e) {
            lastError = e
            LOG.warn('Batch #{} attempt {}/{} failed: {}', counters.batches, attempt, MAX_RETRIES, e.getMessage())

            if (attempt < MAX_RETRIES) {
                Thread.sleep(2000 * attempt)
            }
        }
    }

    if (!batchSuccess) {
        LOG.error('Batch #{} permanently failed after {} retries: {}', counters.batches, MAX_RETRIES, lastError?.getMessage())
        recordList.each { record ->
            setDynamicProperty(record, PROP_STATUS, STATUS_FAILED)
            setDynamicProperty(record, PROP_RETRY, MAX_RETRIES)
        }
        counters.failed += requests.size()
    }

    // Progress log every 10 batches
    if (counters.batches % 10 == 0) {
        def elapsed = (System.currentTimeMillis() - startTime) / 1000
        def total = counters.migrated + counters.failed
        def rate = elapsed > 0 ? (total / elapsed) as int : 0
        LOG.info('=== PROGRESS: Batch #{}, Migrated: {}, Failed: {}, Elapsed: {}s, Rate: {}/s ===',
            counters.batches, counters.migrated, counters.failed, elapsed as int, rate)
    }

    // Cooldown between batches
    if (COOLDOWN_MS > 0) {
        Thread.sleep(COOLDOWN_MS)
    }
}

LOG.info('=== Customer Migration Completed ===')
def totalElapsed = (System.currentTimeMillis() - startTime) / 1000
LOG.info('Total migrated: {}, Total failed: {}, Batches: {}, Time: {}s', counters.migrated, counters.failed, counters.batches, totalElapsed as int)

// ---- Log failed records ----
if (counters.failed > 0) {
    LOG.info('=== Failed Records Details ===')
    def failedPk = 0L
    def failedTotal = 0

    while (true) {
        def fQuery = 'SELECT {pk} FROM {' + ITEM_TYPE_NAME + '} WHERE {pk} > ?lastPk ORDER BY {pk}'
        def fsFailed = new FlexibleSearchQuery(fQuery)
        fsFailed.addQueryParameter('lastPk', failedPk)
        fsFailed.setCount(SCAN_PAGE_SIZE)
        SearchResult failedResult = flexibleSearchService.search(fsFailed)

        if (failedResult.getResult().isEmpty()) {
            break
        }

        for (def record : failedResult.getResult()) {
            failedPk = record.getPk().getLong()
            def status = getDynamicProperty(record, PROP_STATUS)
            if (STATUS_FAILED.equals(status)) {
                def retryCount = getDynamicProperty(record, PROP_RETRY)
                LOG.info('FAILED: pk={}, retryCount={}', record.getPk(), retryCount)
                failedTotal++
            }
        }

        if (failedResult.getResult().size() < SCAN_PAGE_SIZE) {
            break
        }
    }

    LOG.info('=== Total failed records logged: {} ===', failedTotal)
}
"

# JOB
INSERT_UPDATE ScriptingJob; code[unique=true];scriptURI;
                          ;opfCustomerMigrationJob;model://opfCustomerMigrationScript;

# CRON JOB
INSERT_UPDATE CronJob;code[unique=true];job(code)[default=opfCustomerMigrationJob];sessionLanguage(isoCode)[default=en]
                     ;opfCustomerMigrationCronJob
