# -----------------------------------------------------------------------
# Payment Info Migration to OPF - Scripting CronJob

# -----------------------------------------------------------------------

# GROOVY SCRIPT
INSERT_UPDATE Script; code[unique=true];content
                    ;opfPaymentInfoMigrationScript ;"
import de.hybris.platform.core.model.order.payment.CreditCardPaymentInfoModel
import de.hybris.platform.opfservices.data.PaymentTokenImportRequest
import de.hybris.platform.core.model.user.CustomerModel
import de.hybris.platform.servicelayer.search.FlexibleSearchQuery
import de.hybris.platform.servicelayer.search.SearchResult
import de.hybris.platform.util.Config
import org.slf4j.LoggerFactory
import java.text.SimpleDateFormat
import java.util.TimeZone

def LOG = LoggerFactory.getLogger('opfPaymentInfoMigrationScript')

// ---- Configuration ----
def BATCH_SIZE = Config.getInt('opf.migration.batch.size', 500)
def MAX_RETRIES = Config.getInt('opf.migration.max.retries', 3)
def SCAN_PAGE_SIZE = 5000
def COOLDOWN_MS = 2000
def PROP_STATUS = 'migrationStatus'
def PROP_RETRY = 'retryCount'
def STATUS_MIGRATED = 'MIGRATED'
def STATUS_FAILED = 'FAILED'

// ---- Get Spring beans ----
def flexibleSearchService = spring.getBean('flexibleSearchService')
def modelService = spring.getBean('modelService')
def ccAdapterClient = spring.getBean('ccAdapterClient')

// ---- Helper: Format expiry date as MM/yyyy ----
def formatExpiry = { month, year ->
    if (month == null || year == null) return null
    return String.format('%s/%s', month.toString().padLeft(2, '0'), year.toString())
}

// ---- Helper: Get last 4 digits of card number ----
def getLast4 = { number ->
    if (number == null || number.length() < 4) return number
    return number.substring(number.length() - 4)
}

def SINGLE_QUOTE = (char)39 as String

// ---- Helper: Format date to ISO 8601 ----
def formatDate = { date ->
    if (date == null) return null
    def pattern = 'yyyy-MM-dd' + SINGLE_QUOTE + 'T' + SINGLE_QUOTE + 'HH:mm:ss.SSS' + SINGLE_QUOTE + 'Z' + SINGLE_QUOTE
    def sdf = new SimpleDateFormat(pattern)
    sdf.setTimeZone(TimeZone.getTimeZone('UTC'))
    return sdf.format(date)
}

// ---- Helper: Get/Set dynamic properties via Jalo layer ----
def getDynamicProperty = { model, key ->
    return modelService.getSource(model).getProperty(key)
}

def setDynamicProperty = { model, key, value ->
    modelService.getSource(model).setProperty(key, value)
}

// ---- PK-marker based fetch: avoids re-scanning already processed records ----
// Instead of offset-based pagination (which gets slower as offset grows),
// we track the last PK processed and query WHERE {pk} > lastPk
// This is O(1) per page regardless of how many records are already migrated
def lastProcessedPk = 0L

def fetchUnmigratedBatch = { int batchSize ->
    def collected = []
    def currentPk = lastProcessedPk

    while (collected.size() < batchSize) {
        def query = 'SELECT {pk} FROM {CreditCardPaymentInfo} WHERE {pk} > ?lastPk AND {subscriptionId} IS NOT NULL AND {user} IS NOT NULL AND {saved} = 1 ORDER BY {pk}'
        def fsQuery = new FlexibleSearchQuery(query)
        fsQuery.addQueryParameter('lastPk', currentPk)
        fsQuery.setCount(SCAN_PAGE_SIZE)
        SearchResult<CreditCardPaymentInfoModel> result = flexibleSearchService.search(fsQuery)

        if (result.getResult().isEmpty()) {
            break
        }

        for (def pi : result.getResult()) {
            // Track the highest PK we have seen so we never re-scan these records
            currentPk = pi.getPk().getLong()

            def status = getDynamicProperty(pi, PROP_STATUS)
            if (status == null || STATUS_FAILED.equals(status)) {
                collected.add(pi)
                if (collected.size() >= batchSize) break
            }
        }

        // If DB returned fewer than requested, we have reached the end
        if (result.getResult().size() < SCAN_PAGE_SIZE) {
            break
        }
    }

    // Update the marker so the next call starts from where we left off
    lastProcessedPk = currentPk
    return collected
}

// ---- Convert CreditCardPaymentInfo to PaymentTokenImportRequest ----
def convertToImportRequest = { CreditCardPaymentInfoModel pi ->
    def user = pi.getUser()
    def customerId = null
    if (user != null) {
        customerId = modelService.getSource(user).getProperty('customerID')
    }
    if (customerId == null) {
        return null
    }

    def request = new PaymentTokenImportRequest()
    request.setCustomerId(customerId)
    request.setCardType(pi.getType()?.getCode())
    request.setCardLast4(getLast4(pi.getNumber()))
    request.setCardExpiredAt(formatExpiry(pi.getValidToMonth(), pi.getValidToYear()))
    request.setPaymentMethodCode(pi.getType()?.getType())
    request.setAccountGroupId(Config.getString('opf.migration.accountGroupId', '0'))
    request.setPspPaymentMethodId(pi.getSubscriptionId())
    request.setPspCustomerId(null)
    request.setCardBinNumber(pi.getIssueNumber() != null ? String.valueOf(pi.getIssueNumber()) : null)
    request.setCardHolderName(pi.getCcOwner())
    request.setCreatedAt(formatDate(pi.getCreationtime()))
    request.setUpdatedAt(formatDate(pi.getModifiedtime()))
    return request
}


// ---- Processing Migration ----
LOG.info('=== Payment Token Information Migration Started ===')
LOG.info('Batch size: {}, Max retries: {}, Scan page size: {}, Cooldown: {}ms', BATCH_SIZE, MAX_RETRIES, SCAN_PAGE_SIZE, COOLDOWN_MS)

def startTime = System.currentTimeMillis()

def counters = [migrated: 0, failed: 0, batches: 0]
def hasRecords = true

while (hasRecords) {

    def batch = fetchUnmigratedBatch(BATCH_SIZE)

    if (batch.isEmpty()) {
        hasRecords = false
        break
    }

    counters.batches++
    LOG.info('Batch #{}: processing {} records', counters.batches, batch.size())

    // Convert batch to PaymentTokenImportRequest objects
    def requests = []
    def requestToPiMap = []
    batch.each { pi ->
        def request = convertToImportRequest(pi)
        if (request != null) {
            requests.add(request)
            requestToPiMap.add(pi)
        } else {
            setDynamicProperty(pi, PROP_STATUS, STATUS_FAILED)
            setDynamicProperty(pi, PROP_RETRY, MAX_RETRIES)
            counters.failed++
        }
    }

    if (requests.isEmpty()) {
        LOG.info('No valid records in batch, skipping API call')
        continue
    }

    // Call OPF batch import API with retry
    def batchSuccess = false
    def lastError = null

    for (int attempt = 1; attempt <= MAX_RETRIES; attempt++) {
        try {
            def apiStart = System.currentTimeMillis()
            ccAdapterClient.importSavedPaymentTokens(requests)
            def apiElapsed = System.currentTimeMillis() - apiStart

            // Success - mark all records as MIGRATED
            requestToPiMap.each { pi ->
                setDynamicProperty(pi, PROP_STATUS, STATUS_MIGRATED)
                setDynamicProperty(pi, PROP_RETRY, 0)
            }
            counters.migrated += requests.size()
            LOG.info('Batch #{}: API call succeeded in {}ms, {} records migrated', counters.batches, apiElapsed, requests.size())
            batchSuccess = true
            break

        } catch (Exception e) {
            lastError = e
            LOG.warn('Batch #{} attempt {}/{} failed: {}', counters.batches, attempt, MAX_RETRIES, e.getMessage())

            if (attempt < MAX_RETRIES) {
                Thread.sleep(2000 * attempt)
            }
        }
    }

    if (!batchSuccess) {
        LOG.error('Batch #{} permanently failed after {} retries: {}', counters.batches, MAX_RETRIES, lastError?.getMessage())
        requestToPiMap.each { pi ->
            setDynamicProperty(pi, PROP_STATUS, STATUS_FAILED)
            setDynamicProperty(pi, PROP_RETRY, MAX_RETRIES)
        }
        counters.failed += requests.size()
    }

    // Progress log every 10 batches
    if (counters.batches % 10 == 0) {
        def elapsed = (System.currentTimeMillis() - startTime) / 1000
        def total = counters.migrated + counters.failed
        def rate = elapsed > 0 ? (total / elapsed) as int : 0
        LOG.info('=== PROGRESS: Batch #{}, Migrated: {}, Failed: {}, Elapsed: {}s, Rate: {}/s ===',
            counters.batches, counters.migrated, counters.failed, elapsed as int, rate)
    }

    // Cooldown between batches
    if (COOLDOWN_MS > 0) {
        Thread.sleep(COOLDOWN_MS)
    }
}


LOG.info('=== Payment Token Information Migration Completed ===')
def totalElapsed = (System.currentTimeMillis() - startTime) / 1000
LOG.info('Total migrated: {}, Total failed: {}, Batches: {}, Time: {}s', counters.migrated, counters.failed, counters.batches, totalElapsed as int)

// ---- Log failed records ----
if (counters.failed > 0) {
    LOG.info('=== Failed Records Details ===')
    def failedPk = 0L
    def failedTotal = 0

    while (true) {
        def fQuery = 'SELECT {pk} FROM {CreditCardPaymentInfo} WHERE {pk} > ?lastPk AND {subscriptionId} IS NOT NULL AND {user} IS NOT NULL AND {saved} = 1 ORDER BY {pk}'
        def fsFailed = new FlexibleSearchQuery(fQuery)
        fsFailed.addQueryParameter('lastPk', failedPk)
        fsFailed.setCount(SCAN_PAGE_SIZE)
        SearchResult<CreditCardPaymentInfoModel> failedResult = flexibleSearchService.search(fsFailed)

        if (failedResult.getResult().isEmpty()) {
            break
        }

        for (def pi : failedResult.getResult()) {
            failedPk = pi.getPk().getLong()
            def status = getDynamicProperty(pi, PROP_STATUS)
            if (STATUS_FAILED.equals(status)) {
                def retryCount = getDynamicProperty(pi, PROP_RETRY)
                LOG.info('FAILED: pk={}, code={}, retryCount={}',
                    pi.getPk(), pi.getCode(), retryCount)
                failedTotal++
            }
        }

        if (failedResult.getResult().size() < SCAN_PAGE_SIZE) {
            break
        }
    }

    LOG.info('=== Total failed records logged: {} ===', failedTotal)
}
"

# JOB
INSERT_UPDATE ScriptingJob; code[unique=true];scriptURI;
                          ;opfPaymentInfoMigrationJob;model://opfPaymentInfoMigrationScript;

# CRON JOB
INSERT_UPDATE CronJob;code[unique=true];job(code)[default=opfPaymentInfoMigrationJob];sessionLanguage(isoCode)[default=en]
                     ;opfPaymentInfoMigrationCronJob
