# Public oAuth client credential.
#  - Base site suffixed client IDs are for when URL context parameter is needed to determine base site
INSERT_UPDATE OAuthClientDetails; clientId[unique=true]                     ;public ;authorities ;scope ;authorizedGrantTypes             ;registeredRedirectUri                                ;loginPageUri
                                ; mobile_android_public                     ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:4200,http://localhost:4200/cy       ;http://localhost:4200/login
                                ; mobile_android_public_electronics-spa     ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:4200/electronics-spa/oauth-callback ;http://localhost:4200/electronics-spa/login
                                ; mobile_android_public_powertools-spa      ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:4200/powertools-spa/oauth-callback  ;http://localhost:4200/powertools-spa/login
                                ; mobile_android_public_apparel-uk-spa      ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:4200/apparel-uk-spa/oauth-callback  ;http://localhost:4200/apparel-uk-spa/login


# Client details used for b2b storefront
#  - Only required if using a port and it is different than the b2c hosting
INSERT_UPDATE OAuthClientDetails; clientId[unique=true]                     ;public ;authorities ;scope ;authorizedGrantTypes             ;registeredRedirectUri                                ;loginPageUri
                                ; mobile_android_public_b2b                 ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:5200,http://localhost:5200/cy       ;http://localhost:5200/login
                                ; mobile_android_public_b2b_powertools-spa  ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:5200/powertools-spa/oauth-callback ;http://localhost:5200/powertools-spa/login


# Client details used for ASM agent login.
#  - Requires a redirect URI entry for each base site
INSERT_UPDATE OAuthClientDetails; clientId[unique=true] ;public ;authorities ;scope ;authorizedGrantTypes             ;registeredRedirectUri
                                ; asm_client            ;true   ;ROLE_CLIENT ;basic ;authorization_code,refresh_token ;http://localhost:4200,http://localhost:4200/cy,http://localhost:5200,http://localhost:5200/cy,http://localhost:4200/electronics-spa/oauth-callback,http://localhost:4200/powertools-spa/oauth-callback,http://localhost:4200/apparel-uk-spa/oauth-callback,http://localhost:5200/powertools-spa/oauth-callback
